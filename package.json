{
  "name": "zevals",
  "version": "0.1.6",
  "description": "Simple, practical AI evaluations for AI apps.",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && vitest run",
    "update-version": "node scripts/update-version.js",
    "publish-packages": "pnpm update-version && pnpm i && pnpm test && pnpm -r pub"
  },
  "keywords": [
    "ai",
    "evals",
    "evaluation",
    "testing",
    "langchain",
    "langchainjs",
    "langchain-js",
    "langchain-community",
    "langchain-community-js",
    "langchain-community-js"
  ],
  "author": "tabaza@open.cx",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.14",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.2",
    "vitest": "^3.1.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.2",
      "@fastify/static": "^9.1.1",
      "fastify": "^5.8.5",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "brace-expansion@1": "^1.1.12",
      "brace-expansion@2": "^2.0.3",
      "path-to-regexp": "^8.4.0",
      "yaml": "^2.8.3",
      "flatted": "^3.4.2",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "rollup": "^4.59.0",
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "qs": ">=6.15.2 <7",
      "uuid": ">=11.1.1",
      "@modelcontextprotocol/sdk": "^1.26.0",
      "body-parser": "^2.2.1",
      "js-yaml": "^4.1.1",
      "glob": "^11.1.0",
